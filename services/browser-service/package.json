{
  "name": "@live-browser/browser-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/url-policy.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "4.22.3",
    "http-proxy": "1.18.1",
    "playwright": "1.64.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/http-proxy": "1.17.16",
    "@types/node": "22.10.2",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  }
}
